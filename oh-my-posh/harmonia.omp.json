{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": " ",
          "background": "black",
          "foreground": "white",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "blue",
          "foreground": "black",
          "options": {
            "style": "full",
            "folder_separator_icon": "/"
          },
          "template": " {{ $p := splitList \"/\" .Path }}{{ if gt (len $p) 2 }}{{ join \"/\" (slice $p (sub (len $p) 2)) }}{{ else }}{{ .Path }}{{ end }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "green",
          "foreground": "black",
          "template": " {{ .HEAD }} "
        },
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "red",
          "foreground": "black",
          "template": "  {{ .Code }} "
        }
      ]
    }
  ]
}
