      </ViewSelectedBy>
      <GroupBy>
        <PropertyName>PSParentPath</PropertyName>
        <CustomControl>
          <CustomEntries>
            <CustomEntry>
              <CustomItem>
                <ExpressionBinding>
                  <ScriptBlock>
                  $e = [char]27
                  "    $e[38;2;104;108;118mDirectory:$e[0m $e[39m$($_.PSParentPath.Replace('Microsoft.PowerShell.Core\FileSystem::', ''))$e[0m"
                  </ScriptBlock>
                </ExpressionBinding>
              </CustomItem>
            </CustomEntry>
          </CustomEntries>
        </CustomControl>
      </GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
