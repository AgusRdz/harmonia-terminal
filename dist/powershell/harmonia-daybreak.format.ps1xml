        <TableRowEntries>
          <TableRowEntry>
            <Wrap />
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>
                  $e = [char]27
                  $o = foreach ($c in $_.ModeWithoutHardLink.ToCharArray()) {
                    $s = if ($c -eq 'd') { '38;2;26;78;149' } elseif ($c -in 'r', 'h', 's') { '38;2;116;68;0' } elseif ($c -eq 'l') { '38;2;0;82;137' } else { '38;2;104;108;118' }
                    "$e[${s}m$c$e[0m"
                  }
                  $o -join ''
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  $e = [char]27
                  $s = if ($_.LastWriteTime.Date -eq [datetime]::Today) { '39' } else { '38;2;104;108;118' }
                  "$e[${s}m$($_.LastWriteTimeString)$e[0m"
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  $e = [char]27
                  $t = $_.LengthString
                  if ($t) { "$e[38;2;104;108;118m$t$e[0m" } else { $t }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.Name.StartsWith('.') -and -not $_.LinkType) {
                    $e = [char]27
                    $s = if ($_.PSIsContainer) { '38;2;56;108;181' } else { '38;2;102;107;116' }
                    "$e[${s}m$($_.Name)$e[0m"
                  } else {
                    $_.NameString
                  }
                </ScriptBlock>
              </TableColumnItem>
